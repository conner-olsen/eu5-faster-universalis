# Speed Watcher — if the game speed drops below the mod range, reset to mod speed 1.
widget = {
	name = "fum_speed_watcher"
	size = { 0 0 }
	visible_at_creation = no
	visible = "[And(IsGameSpeedEqualOrGreaterThan('(int32)1'), Not(IsGameSpeedEqualOrGreaterThan('(int32)15')))]"

	state = {
		name = _show
		on_start = "[OnSetGameSpeed('(int32)15')]"
	}
}
